# Copy to .env and fill in. .env is gitignored; .env.example is not, so never
# put a real secret in this file.

# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------
# Local Postgres in Docker:
#   docker run -d --name sareefusion-db -e POSTGRES_PASSWORD=dev \
#     -e POSTGRES_DB=sareefusion -p 5432:5432 postgres:16
DATABASE_URL=postgresql://postgres:dev@localhost:5432/sareefusion

# ---------------------------------------------------------------------------
# Google sign-in (required)
# ---------------------------------------------------------------------------
# From console.cloud.google.com -> APIs & Services -> Credentials
#   -> Create credentials -> OAuth client ID -> Web application
# Authorised JavaScript origins must include:
#   http://localhost:5173        (Vite dev server)
#   https://<your-vercel-domain> (production)
# No redirect URI is needed: Google Identity Services returns the token in-page.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Signs our own session cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it signs everyone out. Required in production; a dev fallback is
# used locally so first run works without it.
SESSION_SECRET=

# ---------------------------------------------------------------------------
# Claiming the records that existed before accounts
# ---------------------------------------------------------------------------
# migrate.py imports the old JSON records with no owner. The account whose
# Google email matches this address claims them on its first sign-in. Gating on
# a named address stops whoever signs in first from taking that data.
# Leave blank once the records have been claimed.
BOOTSTRAP_OWNER_EMAIL=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Only needed if the frontend is served from an origin other than the API's.
# With the Vite proxy (dev) and the vercel.json rewrite (production) requests
# are same-origin and this is unused.
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Send the session cookie only over HTTPS. Set automatically on Vercel; leave
# unset for plain-HTTP localhost or the browser will refuse to store it.
# SESSION_COOKIE_SECURE=true

# Existing key for the design generator, unchanged by this work.
# GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Image storage (optional)
# ---------------------------------------------------------------------------
# Unset: designs and loom files serve from local disk, with a Postgres copy as
# fallback. Set: they go to Cloudflare R2, and /api/static issues a short-lived
# presigned URL after its ownership check, so the browser fetches the bytes
# straight from R2 and Flask carries no image traffic.
#
# Keep the bucket PRIVATE. The presigned URLs are what grant access; a public
# bucket would undo per-user privacy.
#
# Cloudflare dashboard > R2 > create bucket, then Manage API tokens >
# Object Read & Write.
# R2_ACCOUNT_ID=
# R2_BUCKET=sareefusion-designs
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# Folder inside the bucket (default: static)
# BLOB_PREFIX=static

# Presigned URL lifetime in seconds (default: 900 = 15 minutes)
# BLOB_SIGNED_URL_TTL=900

# For Amazon S3, Backblaze B2 or MinIO instead of R2, set these rather than
# R2_ACCOUNT_ID:
# S3_ENDPOINT_URL=https://s3.us-east-1.amazonaws.com
# S3_REGION=us-east-1

# ---------------------------------------------------------------------------
# Admin portal
# ---------------------------------------------------------------------------
# Signs the admin session cookie. Deliberately separate from SESSION_SECRET so
# one leaking does not grant the other. There is NO dev fallback: admin login
# fails loudly when this is unset, because a constant in source would let
# anyone mint an admin session.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# ADMIN_SESSION_SECRET=

# Set these with:  python admin.py --set-password
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD_HASH=
